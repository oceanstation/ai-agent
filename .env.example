# =============================================================================
# ai-agent 环境变量示例
# -----------------------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为 `.env`： cp .env.example .env
#   2. 按需修改下列变量的值
# 说明：
#   - 所有变量均可选，未设置时使用代码中的默认值（注释里已标注）
#   - 涉及路径的变量若填相对路径，会相对进程启动目录（process.cwd()）解析
# =============================================================================


# -----------------------------------------------------------------------------
# 服务运行
# -----------------------------------------------------------------------------
# NestJS 后端监听端口，默认 3000
PORT=3000

# Node 运行环境，影响 webpack 等构建行为
# 可选值：development | production
NODE_ENV=development

# 是否启用 CORS。默认关闭（web 部署通常经反向代理，无跨源问题）。
# Electron 桌面壳会主动设为 true —— renderer 从 `file://` / `localhost:4200`
# 直连 agent 时是跨源，需要 CORS 才能通过浏览器同源策略。
# AGENT_CORS=false


# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# LLM：模型分层（tier-based routing）
# -----------------------------------------------------------------------------
# 系统根据本轮任务类型自动路由到不同档位的模型：
#   - fast：默认对话、Memory Flush、search subagent（低延迟 / 低成本）
#   - pro：SDD 四阶段推理、深度分析请求（高质量 / 深度思考）
#
# fast 是"基线档"，pro 缺失的字段会从 fast 补齐 —— 只补 LLM_PRO_MODEL 即可切换 pro 模型。
# 未来扩展：新增 tier 请同时更新 apps/agent/.../llm/llm.service.ts 中的 ModelTier。

# —— fast（必填）——
LLM_FAST_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_FAST_API_URL=https://api.deepseek.com
LLM_FAST_MODEL=deepseek-v4-flash

# —— pro（未填任一字段则从 fast 补齐）——
LLM_PRO_API_KEY=
LLM_PRO_API_URL=
LLM_PRO_MODEL=deepseek-v4-pro


# -----------------------------------------------------------------------------
# 搜索工具：Tavily
# -----------------------------------------------------------------------------
# 未配置时，Agent 的联网搜索工具不可用（其他能力不受影响）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# MCP：Model Context Protocol servers
# -----------------------------------------------------------------------------
# 高德地图 MCP 服务的 API Key
AMAP_MCP_KEY=


# -----------------------------------------------------------------------------
# History：会话历史（SQLite）
# -----------------------------------------------------------------------------
# SQLite 数据库文件位置，默认 apps/agent/.data/history.db（相对仓库根）
HISTORY_DB_PATH=apps/agent/.data/history.db


# -----------------------------------------------------------------------------
# Memory：长期记忆
# -----------------------------------------------------------------------------
# 记忆根目录，默认 apps/agent/.memory（相对仓库根）
#   - MEMORY.md          常青记忆
#   - memory/YYYY-MM-DD  每日日志
MEMORY_ROOT=apps/agent/.memory

# 组 system prompt 时拼接最近多少天的日志，默认 3
MEMORY_RECENT_DAYS=3

# 是否启用自动 Flush，默认 true；设为 false 可关闭
MEMORY_FLUSH_ENABLED=true

# 每 N 轮触发一次 Flush，默认 1
MEMORY_FLUSH_EVERY_TURNS=1

# Flush 时至少要有 N 条消息才执行，默认 2（用于过滤空会话）
MEMORY_FLUSH_MIN_MESSAGES=2


# -----------------------------------------------------------------------------
# Skills：Agent 技能库（Progressive Disclosure）
# -----------------------------------------------------------------------------
# Skill 根目录，默认 apps/agent/.skills（相对仓库根）
#   目录结构：<SKILLS_ROOT>/<skill-name>/SKILL.md
#   SKILL.md 需含 YAML frontmatter：name / description（用于渐进式披露）
SKILLS_ROOT=apps/agent/.skills


# -----------------------------------------------------------------------------
# Knowledge：Chroma Cloud 向量库
# -----------------------------------------------------------------------------
# Chroma Cloud API Key（必填，未填时首次调用 knowledge 查询会抛错）
CHROMA_API_KEY=

# 租户 ID（tenant UUID）
CHROMA_TENANT=

# 数据库名
CHROMA_DATABASE=

# 集合名
CHROMA_COLLECTION=


# -----------------------------------------------------------------------------
# Workspace：Agent 可读写的用户项目目录（read_file / write_file / list_dir / run_command）
# -----------------------------------------------------------------------------
# workspace 根目录（绝对路径优先；相对路径相对 process.cwd()）
# 未设置时默认 process.cwd()，生产环境务必显式指定
WORKSPACE_ROOT=workspace

# 是否允许 write_file（默认 false = 只读，最小权限原则）
WORKSPACE_WRITABLE=false

# 是否允许 run_command（默认 false = 禁用命令执行）
WORKSPACE_COMMAND_ENABLED=false

# run_command 白名单（逗号分隔的可执行文件名），仅在命名单中的命令可被调用
WORKSPACE_COMMAND_ALLOWLIST=ls,cat

# 单文件读写字节上限，默认 1048576（1MB）
WORKSPACE_MAX_FILE_SIZE=1048576

# list_dir 每次最多返回的条目数，默认 200
WORKSPACE_MAX_LIST_ENTRIES=200

# run_command 单次 stdout/stderr 字节上限，默认 65536（64KB）
WORKSPACE_MAX_COMMAND_OUTPUT=65536

# run_command 超时毫秒，默认 30000（30 秒）
WORKSPACE_COMMAND_TIMEOUT_MS=30000

# 额外的 deny glob 列表（逗号分隔），会追加到内置禁区（.git、node_modules、.env*、*.pem、*.key）之后
# 例：WORKSPACE_DENY_GLOBS=dist/**,build/**,coverage/**
WORKSPACE_DENY_GLOBS=

# 是否按会话（sessionId）隔离文件读写，默认 true。
# 开启后每个会话的 read/write/list/run_command 落在 <WORKSPACE_ROOT>/<WORKSPACE_SESSIONS_DIR>/<sessionId>/ 下，
# 会话之间互不可见、无法用 ../ 越界；设为 false 回退到所有会话共享同一个 WORKSPACE_ROOT。
# 注意：SDD 的 .specify 产物不受此开关影响，始终全局共享。
WORKSPACE_ISOLATE_BY_SESSION=true

# 会话隔离时的子目录容器名（相对 WORKSPACE_ROOT），默认 sessions
WORKSPACE_SESSIONS_DIR=sessions
