{
  "name": "@ai-agent/chroma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "projectType": "application",
    "sourceRoot": "apps/chroma",
    "tags": ["type:app"],
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec chroma run --path ./data",
          "cwd": "apps/chroma"
        }
      }
    }
  },
  "scripts": {
    "embedding": "tsx embedding.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "chromadb": "^3.5.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
