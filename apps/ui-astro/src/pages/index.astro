---
import Base from '@/layouts/Base.astro';
import ChatView from '@/views/ChatView.vue';

// 首页显式声明走 SSR（hybrid 效果）：外壳服务端渲染，聊天区做为客户端 island 挂载
export const prerender = false;
---
<Base title="AI Agent">
  <!--
    ChatView 依赖浏览器 API（SSE / DOM 滚动 / clipboard），使用 client:only
    避免 SSR 阶段执行浏览器代码，服务端只吐出占位骨架。
    slot="fallback" 内容在服务端渲染，客户端 Vue 挂载完成后自动替换，
    可避免首屏空白 + hydrate 时的布局跳动。
  -->
  <ChatView client:only="vue">
    <div slot="fallback" class="chat-skeleton" aria-hidden="true">
      <div class="skeleton-messages">
        <div class="skeleton-row assistant">
          <div class="skeleton-bubble" style="width: 60%;"></div>
        </div>
        <div class="skeleton-row user">
          <div class="skeleton-bubble" style="width: 40%;"></div>
        </div>
        <div class="skeleton-row assistant">
          <div class="skeleton-bubble" style="width: 75%;"></div>
        </div>
      </div>
      <div class="skeleton-input">
        <div class="skeleton-textarea"></div>
        <div class="skeleton-send"></div>
      </div>
    </div>
  </ChatView>
</Base>

<style>
  /* 骨架屏样式：布局刻意贴近真实 ChatView，hydrate 完成后无感切换 */
  .chat-skeleton {
    display: flex;
    flex-direction: column;
    height: 100vh;
    margin: 0 auto;
    padding: 5px;
    box-sizing: border-box;
    max-width: 888px;
  }

  .skeleton-messages {
    flex: 1;
    background: #f6f6f6;
    border-radius: 10px;
    padding: 20px 20px 120px 20px;
    overflow: hidden;
  }

  .skeleton-row {
    display: flex;
    margin-bottom: 10px;
  }

  .skeleton-row.user {
    justify-content: flex-end;
  }

  .skeleton-bubble {
    height: 32px;
    background: linear-gradient(90deg, #ececec 25%, #f5f5f5 37%, #ececec 63%);
    background-size: 400% 100%;
    animation: skeleton-shine 1.4s ease infinite;
  }

  .skeleton-row.assistant .skeleton-bubble {
    border-radius: 0 12px 12px 12px;
  }

  .skeleton-row.user .skeleton-bubble {
    border-radius: 12px 12px 0 12px;
  }

  .skeleton-input {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 95%;
    min-width: 300px;
    max-width: 800px;
  }

  .skeleton-textarea {
    width: 100%;
    height: 88px;
    border-radius: 8px;
    background: linear-gradient(90deg, #ececec 25%, #f5f5f5 37%, #ececec 63%);
    background-size: 400% 100%;
    animation: skeleton-shine 1.4s ease infinite;
    border: 1px solid #e8e8e8;
  }

  .skeleton-send {
    position: absolute;
    right: 10px;
    bottom: 15px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #e0e0e0;
  }

  @keyframes skeleton-shine {
    0% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0 50%;
    }
  }
</style>
